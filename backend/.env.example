PORT=8000
NODE_ENV=development
API_V1_STR=/api/v1

# Masukkan Google Gemini API Key Anda di bawah ini
# Dapatkan gratis di https://aistudio.google.com/
GEMINI_API_KEY=
# Model Gemini: Kosongkan atau isi 'auto' agar sistem selalu otomatis mendeteksi model multimodal terbaru (gemini-flash-latest)
GEMINI_MODEL=auto
